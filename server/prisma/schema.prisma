// Xpand CS Academy portal — data model (M0).
// See docs/ARCHITECTURE.md for the rules each table supports.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identity ─────────────────────────────

enum Role {
  SUPER_ADMIN
  INSTRUCTOR
  STUDENT
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique
  passwordHash       String
  fullName           String
  email              String?
  mobile             String?
  role               Role      @default(STUDENT)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  // Anchor for join-date-relative schedules on assignments that target this user directly.
  joinDate           DateTime? @db.Date
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions    Session[]
  memberships GroupMember[]
  grants      InstructorGrant[] @relation("grantee")
  attempts    Attempt[]
  overrides   AccessOverride[]
  warnings    Warning[]         @relation("warned")
  attendance  Attendance[]
  auditLogs   AuditLog[]
  assignments Assignment[]
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the opaque cookie token; the raw token is never stored.
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?

  @@index([userId])
}

// A cohort / intake. Replaces the single global "intake_start_date" script property.
model Group {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique
  intakeStartDate DateTime @db.Date
  createdAt       DateTime @default(now())

  members     GroupMember[]
  assignments Assignment[]
  overrides   AccessOverride[]
  grantScopes GrantGroup[]
}

model GroupMember {
  userId   String    @db.Uuid
  groupId  String    @db.Uuid
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // Late joiners: overrides the group's intakeStartDate as the anchor for relative schedules.
  joinDate DateTime? @db.Date
  addedAt  DateTime  @default(now())

  @@id([userId, groupId])
  @@index([groupId])
}

// ───────────────────────── Access control ─────────────────────────

enum Permission {
  EXAM_EDIT // create/edit exam settings, questions, materials
  EXAM_ASSIGN // assign exams to users/groups
  EXAM_SCHEDULE // schedule, open, close
  RESULTS_VIEW // see attempts and scores
  RESULTS_RELEASE // publish results to students
  PROCTOR // live board, force submit, extend time, allow resume
  ATTEMPT_VOID // void / reopen a submitted attempt
  ATTEMPT_REVIEW // move submitted attempts through under-review / reviewed
  AUDIT_VIEW // read audit log entries within scope
}

// One scoped grant to an instructor: permissions × exams × groups.
// Super admins implicitly hold every permission on everything and need no grant.
model InstructorGrant {
  id                   String       @id @default(uuid()) @db.Uuid
  userId               String       @db.Uuid
  user                 User         @relation("grantee", fields: [userId], references: [id], onDelete: Cascade)
  permissions          Permission[]
  allExams             Boolean      @default(false)
  allGroups            Boolean      @default(false)
  // Student scope "students who submitted an exam this grant covers" (instead of groups).
  studentsWhoSubmitted Boolean      @default(false)
  expiresAt            DateTime?
  createdById          String?      @db.Uuid
  createdAt            DateTime     @default(now())

  exams      GrantExam[]
  groups     GrantGroup[]
  categories GrantCategory[]
  tags       GrantTag[]

  @@index([userId])
}

model GrantExam {
  grantId String          @db.Uuid
  examId  String          @db.Uuid
  grant   InstructorGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  exam    Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@id([grantId, examId])
}

model GrantGroup {
  grantId String          @db.Uuid
  groupId String          @db.Uuid
  grant   InstructorGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  group   Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([grantId, groupId])
}

// Exams in this category are in the grant scope — including exams created later (decision D5).
model GrantCategory {
  grantId    String          @db.Uuid
  categoryId String          @db.Uuid
  grant      InstructorGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  category   Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([grantId, categoryId])
}

// ─────────────────────────── Exam catalog ───────────────────────────

// Flat list; every exam has exactly one (decision D1). Archived categories stay for history.
// Names are unique case-insensitively (index in the migration).
// Covers every exam carrying this tag (any of a grant's tags), including exams tagged later.
model GrantTag {
  grantId String          @db.Uuid
  tagId   String          @db.Uuid
  grant   InstructorGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  tag     Tag             @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([grantId, tagId])
  @@index([tagId])
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  position  Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  exams       Exam[]
  grantScopes GrantCategory[]
}

// Cross-cutting labels; the list is managed by super admins (decision D4).
model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  exams       ExamTag[]
  grantScopes GrantTag[]
}

model ExamTag {
  examId String @db.Uuid
  tagId  String @db.Uuid
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([examId, tagId])
  @@index([tagId])
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// What kinds of questions the exam may contain (docs/EXAM_TYPES_PLAN.md).
enum ExamType {
  MCQ // single choice, multi choice and true/false only
  MCQ_ESSAY // may also contain ESSAY questions
}

// How a finished attempt gets its score. MCQ_ESSAY exams are always MANUAL_APPROVAL (CHECK constraint).
enum ScoringMode {
  AUTO // graded on submit
  MANUAL_APPROVAL // graded by staff; the score is set when the attempt is approved
}

model Exam {
  id                  String      @id @default(uuid()) @db.Uuid
  code                String      @unique // e.g. "NET-FUND"
  title               String
  categoryId          String      @db.Uuid
  category            Category    @relation(fields: [categoryId], references: [id])
  status              ExamStatus  @default(DRAFT)
  durationMinutes     Int
  passMark            Decimal     @default(80) @db.Decimal(5, 2) // percent
  weight              Decimal     @default(15) @db.Decimal(5, 2) // share of the overall total
  maxAttempts         Int         @default(1)
  // Taken outside the platform (e.g. CTF): scores are entered manually, no online session.
  isExternal          Boolean     @default(false)
  allowBackNavigation Boolean     @default(true)
  shuffleQuestions    Boolean     @default(true)
  shuffleOptions      Boolean     @default(true)
  questionsPerAttempt Int? // null = all questions
  strikeLimit         Int         @default(3) // violations before auto-submit
  requireFullscreen   Boolean     @default(true)
  requireSafeBrowser  Boolean     @default(false) // M2: Safe Exam Browser
  sebConfigKeyHash    String?
  accessCodeHash      String? // optional proctor PIN to start
  resultsReleased     Boolean     @default(false)
  type                ExamType    @default(MCQ)
  scoringMode         ScoringMode @default(AUTO)
  // Shown before the exam starts and during it ("The story so far", instructions). Plain text.
  intro               String?
  // Case hints are sent to students only when this is on (docs/CASE_QUESTIONS_PLAN.md C9).
  showHints           Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  questions   Question[]
  cases       QuestionCase[]
  uploads     Upload[]
  materials   Material[]
  assignments Assignment[]
  overrides   AccessOverride[]
  attempts    Attempt[]
  grantScopes GrantExam[]
  tags        ExamTag[]

  @@index([categoryId])
}

enum QuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  TRUE_FALSE
  ESSAY // free text, no options; graded by staff (MCQ_ESSAY exams only)
}

enum AnswerSize {
  SHORT // one line, at most 300 characters
  LONG // a text area, at most 10,000 characters
}

/**
 * A use-case block (docs/CASE_QUESTIONS_PLAN.md): one situation shared by a choice question and its
 * written follow-ups. Its questions are contiguous in the exam's question order and are delivered
 * together, in their order (shuffling moves the whole case).
 */
model QuestionCase {
  id        String   @id @default(uuid()) @db.Uuid
  examId    String   @db.Uuid
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  // Short chip, e.g. KNOWLEDGE, DESIGN, FILL IN, TROUBLESHOOT.
  label     String?
  title     String
  situation String
  // Sent to students only when the exam's showHints is on.
  hint      String?
  imageId   String?  @db.Uuid
  image     Upload?  @relation(fields: [imageId], references: [id])
  imageAlt  String?
  createdAt DateTime @default(now())

  questions Question[]

  @@index([examId])
}

model Question {
  id         String        @id @default(uuid()) @db.Uuid
  examId     String        @db.Uuid
  exam       Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  type       QuestionType
  text       String
  // An outside https link (older questions); imageId (an upload) is preferred.
  imageUrl   String?
  imageId    String?       @db.Uuid
  image      Upload?       @relation(fields: [imageId], references: [id])
  imageAlt   String?
  points     Decimal       @default(1) @db.Decimal(6, 2)
  position   Int
  // ESSAY only: notes for graders (model answer, rubric). Staff only, never serialized to students.
  guidance   String?
  // ESSAY only: the size of the answer box (and its limit).
  answerSize AnswerSize    @default(LONG)
  caseId     String?       @db.Uuid
  case       QuestionCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)

  options Option[]
  answers AttemptAnswer[]

  @@index([examId])
  @@index([caseId])
}

model Option {
  id          String   @id @default(uuid()) @db.Uuid
  questionId  String   @db.Uuid
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  // May be empty when the option is a picture.
  text        String   @default("")
  // A neutral second line shown under the text (students see it).
  detail      String?
  imageId     String?  @db.Uuid
  image       Upload?  @relation(fields: [imageId], references: [id])
  imageAlt    String?
  // Never serialized to students; grading happens server-side.
  isCorrect   Boolean  @default(false)
  // Why this option is right or wrong. Staff only, never serialized to students.
  explanation String?
  position    Int

  @@index([questionId])
}

/**
 * An uploaded picture (png, jpeg or webp; metadata stripped). Stored in the database so backups
 * include it. Readable by staff who can see an exam using it, and by students during an attempt
 * of such an exam (docs/CASE_QUESTIONS_PLAN.md C8).
 */
model Upload {
  id          String   @id @default(uuid()) @db.Uuid
  // The exam it was uploaded for (copies of the exam reuse it).
  examId      String   @db.Uuid
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  mime        String
  size        Int
  sha256      String
  width       Int
  height      Int
  data        Bytes
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  questions Question[]
  options   Option[]
  cases     QuestionCase[]

  @@index([examId])
}

model Material {
  id       String @id @default(uuid()) @db.Uuid
  examId   String @db.Uuid
  exam     Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  title    String
  url      String
  position Int    @default(0)
}

// ─────────────────────── Assignment & schedule ───────────────────────

enum ScheduleMode {
  FIXED // opensAt .. closesAt
  RELATIVE // anchor date + offsetDays at openTime, open for windowMinutes
  MANUAL // visible, but only opens through an AccessOverride
}

// Makes an exam visible to a user or a group, and says when it opens.
// Exactly one of userId / groupId is set (enforced by a CHECK constraint in the migration).
model Assignment {
  id            String       @id @default(uuid()) @db.Uuid
  examId        String       @db.Uuid
  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId        String?      @db.Uuid
  user          User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId       String?      @db.Uuid
  group         Group?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  mode          ScheduleMode @default(MANUAL)
  opensAt       DateTime?
  closesAt      DateTime?
  offsetDays    Int?
  openTime      String? // "HH:mm", interpreted in the app time zone (Africa/Cairo)
  windowMinutes Int?
  createdById   String?      @db.Uuid
  createdAt     DateTime     @default(now())

  // An exam is assigned to a target at most once (duplicates are a 409, never stacked).
  @@unique([examId, userId])
  @@unique([examId, groupId])
  @@index([userId])
  @@index([groupId])
}

enum OverrideAction {
  OPEN
  CLOSE
}

// Manual open/close on top of the schedule. Precedence (resolved in code):
// user override > group override > assignment schedule > closed.
model AccessOverride {
  id          String         @id @default(uuid()) @db.Uuid
  examId      String         @db.Uuid
  exam        Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId      String?        @db.Uuid
  user        User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId     String?        @db.Uuid
  group       Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  action      OverrideAction
  validFrom   DateTime       @default(now())
  validUntil  DateTime?
  reason      String?
  createdById String?        @db.Uuid
  createdAt   DateTime       @default(now())

  @@index([examId])
}

// ───────────────────────────── Attempts ─────────────────────────────

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED // deadline reached or strike limit hit
  FORCE_SUBMITTED // by a proctor
  VOIDED
}

// Staff review after submission. With the attempt status this gives the student-facing progress:
// NOT_STARTED → IN_PROGRESS → ANSWERED (submitted, PENDING) → UNDER_REVIEW → REVIEWED.
enum ReviewStatus {
  PENDING
  UNDER_REVIEW
  REVIEWED
}

enum AttemptSource {
  ONLINE
  MANUAL // externally graded (CTF) or entered by staff
}

model Attempt {
  id                String        @id @default(uuid()) @db.Uuid
  examId            String        @db.Uuid
  exam              Exam          @relation(fields: [examId], references: [id])
  userId            String        @db.Uuid
  user              User          @relation(fields: [userId], references: [id])
  attemptNo         Int           @default(1)
  source            AttemptSource @default(ONLINE)
  status            AttemptStatus @default(IN_PROGRESS)
  startedAt         DateTime      @default(now())
  // Server-authoritative; the client timer is display only.
  deadlineAt        DateTime?
  extraMinutes      Int           @default(0)
  submittedAt       DateTime?
  submitReason      String?
  score             Decimal?      @db.Decimal(8, 2)
  maxScore          Decimal?      @db.Decimal(8, 2)
  // Per-attempt randomization: question ids in delivery order, and option order per question.
  questionOrder     Json?
  optionOrder       Json?
  // Binds the attempt to one browser session; a second device invalidates it.
  sessionTokenHash  String?
  deviceFingerprint String?
  lastHeartbeatAt   DateTime?
  strikes           Int           @default(0)
  // The login session that started the attempt: only it may continue (one device; no "allow resume").
  sessionId         String?       @db.Uuid
  // Signals until this instant count as the same action (one Alt+Tab = one strike).
  strikeMergedUntil DateTime?
  // Without back navigation: questions before this index are closed.
  furthestIndex     Int           @default(0)
  reviewStatus      ReviewStatus  @default(PENDING)
  reviewedById      String?       @db.Uuid
  reviewedAt        DateTime?
  voidedById        String?       @db.Uuid
  voidReason        String?
  // Optimistic locking for grading: incremented on every grading change (two graders can't overwrite).
  gradingVersion    Int           @default(0)
  createdAt         DateTime      @default(now())

  answers    AttemptAnswer[]
  violations Violation[]

  @@unique([examId, userId, attemptNo])
  @@index([userId])
  @@index([examId, reviewStatus])
}

model AttemptAnswer {
  attemptId         String    @db.Uuid
  questionId        String    @db.Uuid
  attempt           Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question          Question  @relation(fields: [questionId], references: [id])
  selectedOptionIds String[]  @default([]) @db.Uuid
  // ESSAY answer (plain text, at most 10,000 characters).
  text              String?
  answeredAt        DateTime  @default(now())
  // Choice questions: points computed on submit.
  autoPoints        Decimal?  @db.Decimal(6, 2)
  // Points given by a grader: essays, or an override of autoPoints (then overrideReason is set).
  awardedPoints     Decimal?  @db.Decimal(6, 2)
  overrideReason    String?
  feedback          String?
  gradedById        String?   @db.Uuid
  gradedAt          DateTime?

  @@id([attemptId, questionId])
}

enum ViolationType {
  FULLSCREEN_EXIT
  TAB_HIDDEN
  WINDOW_BLUR
  RESIZE
  CLIPBOARD
  CONTEXT_MENU
  BLOCKED_SHORTCUT
  DEVTOOLS
  HEARTBEAT_MISSED
  DEVICE_CHANGE
  SEB_MISSING
}

model Violation {
  id             String        @id @default(uuid()) @db.Uuid
  attemptId      String        @db.Uuid
  attempt        Attempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  type           ViolationType
  countsAsStrike Boolean       @default(true)
  detail         Json?
  clientTime     DateTime?
  ip             String?
  occurredAt     DateTime      @default(now())

  @@index([attemptId])
}

// ─────────────────────── Program operations ───────────────────────

model Warning {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation("warned", fields: [userId], references: [id], onDelete: Cascade)
  reason     String
  issuedById String?  @db.Uuid
  issuedAt   DateTime @default(now())
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

model Attendance {
  userId       String           @db.Uuid
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime         @db.Date
  status       AttendanceStatus
  recordedById String?          @db.Uuid
  recordedAt   DateTime         @default(now())

  @@id([userId, date])
}

// Append-only record of staff actions and exam session events.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String // e.g. "auth.login", "exam.schedule", "attempt.void"
  entityType String?
  entityId   String?
  detail     Json?
  ip         String?
  at         DateTime @default(now())

  @@index([actorId, at])
  @@index([entityType, entityId])
}
