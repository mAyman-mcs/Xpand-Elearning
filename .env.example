# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=8080

POSTGRES_USER=xpand
POSTGRES_PASSWORD=change-me
POSTGRES_DB=xpand
DATABASE_URL=postgresql://xpand:change-me@db:5432/xpand

# Set to the number of proxies in front of the app (1 for nginx/ALB) so client IPs are correct.
TRUST_PROXY=1
# Set to false only for local http testing; cookies are Secure in production.
COOKIE_SECURE=true

SESSION_IDLE_MINUTES=20
SESSION_MAX_HOURS=12
