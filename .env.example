# Copy to .env (chmod 600) and fill in. Never commit .env. See docs/DEPLOY.md.
NODE_ENV=production
PORT=8080

# Public hostname; Caddy gets the HTTPS certificate for it.
DOMAIN=portal.example.com

POSTGRES_USER=xpand
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=xpand
DATABASE_URL=postgresql://xpand:change-me-to-a-long-random-string@db:5432/xpand

# One proxy (Caddy) in front of the app, so client IPs are read from X-Forwarded-For.
TRUST_PROXY=1
COOKIE_SECURE=true

SESSION_IDLE_MINUTES=20
SESSION_MAX_HOURS=12
LOGIN_RATE_LIMIT=20
LOG_LEVEL=info

# Optional: CloudWatch logs (docker-compose.aws.yml) and S3 backups (ops/backup.sh).
AWS_REGION=eu-central-1
CLOUDWATCH_LOG_GROUP=xpand-portal
BACKUP_S3_URI=s3://your-bucket/xpand-portal
